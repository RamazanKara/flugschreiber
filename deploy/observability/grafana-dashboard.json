{
  "__meta": "Flugschreiber Grafana dashboard. Reads the metrics exported by internal/metrics; every expression uses the real metric and label names. Import against a Prometheus that scrapes the proxy's /metrics, or ship it through the chart's dashboards.enabled ConfigMap for the Grafana sidecar to pick up. Compatible with Grafana 10 and later.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "flugschreiber",
    "ai-act",
    "evidence"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(flugschreiber_requests_total, job)",
        "hide": 0,
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": {
          "query": "label_values(flugschreiber_requests_total, job)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Flugschreiber",
  "uid": "flugschreiber",
  "version": 1,
  "weekStart": "",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by endpoint and status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Proxied interactions per second from flugschreiber_requests_total, split by endpoint class and HTTP status class.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (endpoint, status_class) (rate(flugschreiber_requests_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}} {{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Capture errors by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_capture_errors_total per second, by reason. Anything above zero is an interaction that was not fully recorded.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(flugschreiber_capture_errors_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Interaction duration percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "p50 and p95 of flugschreiber_request_duration_seconds by endpoint, from the histogram buckets.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(flugschreiber_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(flugschreiber_request_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95 {{endpoint}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Upstream time to first byte percentiles",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "p50 and p95 of flugschreiber_upstream_ttfb_seconds by endpoint, from the histogram buckets. This is the upstream's prefill plus the proxy's own overhead.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(flugschreiber_upstream_ttfb_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p50 {{endpoint}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(flugschreiber_upstream_ttfb_seconds_bucket{job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "p95 {{endpoint}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Token rate by model and kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Tokens per second from flugschreiber_tokens_total, by served model and prompt or completion.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (model, kind) (rate(flugschreiber_tokens_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{model}} {{kind}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Evidence on disk",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_evidence_bytes, the total size of the evidence segments. A flat line while requests keep arriving is the shape of a capture stall.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "flugschreiber_evidence_bytes{job=~\"$job\"}",
          "legendFormat": "bytes"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Evidence records",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_evidence_records, the number of records in the log including those written by earlier runs.",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(flugschreiber_evidence_records{job=~\"$job\"})",
          "legendFormat": "records"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checkpoint rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Signed checkpoints per second from flugschreiber_checkpoints_total.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(flugschreiber_checkpoints_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "checkpoints"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Archive upload rate by backend and result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_archive_uploads_total per second, by backend and outcome. A rising failure series is what the archive alert fires on.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*failure.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (backend, result) (rate(flugschreiber_archive_uploads_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{backend}} {{result}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Records appended rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_events_appended_total per second, the records this process wrote to the chain.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(flugschreiber_events_appended_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "appended"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Evidence over its size cap",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_evidence_bytes_over_cap. Anything above zero means the retention floor is holding evidence the volume has no room for. Nothing will be deleted to fix it: add storage or record less.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(flugschreiber_evidence_bytes_over_cap{job=~\"$job\"})",
          "legendFormat": "over cap"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Timestamp anchoring by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "flugschreiber_timestamps_total. An authority that stops answering costs anchors and never records, so failures here are not evidence loss. They mean checkpoint times are this host's claim rather than a third party's.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(flugschreiber_timestamps_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
